{
  "name": "html2mp4",
  "version": "1.0.0",
  "description": "Record a self-contained HTML animation to MP4 through the real Chrome compositor",
  "main": "record.js",
  "bin": { "html2mp4": "record.js" },
  "scripts": {
    "test": "node --test",
    "example": "node record.js example/bars.html --out example/bars.mp4 --width 720 --height 720 --duration 4"
  },
  "keywords": ["html", "video", "mp4", "puppeteer", "ffmpeg", "screencast", "animation"],
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "puppeteer": "^24.43.1"
  }
}
